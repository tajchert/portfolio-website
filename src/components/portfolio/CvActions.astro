---
// CV file cards with Markdown COPY / SAVE actions and a PDF download. The markdown is the single
// canonical file at the repo root, imported raw at build time and passed
// to the cv-actions web component as base64 (UTF-8 safe).
import cvRaw from '../../../michal-tajchert-cv.md?raw';
const cvB64 = Buffer.from(cvRaw, 'utf-8').toString('base64');
---
<cv-actions
  data-filename="michal-tajchert-cv.md"
  data-label="CURRICULUM VITAE · 履歴書"
  data-md={cvB64}
></cv-actions>
<div style="border:1px solid #242424;border-radius:14px;background:#0d0d0d;padding:16px 18px 16px 22px;display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:12px;">
  <span style="font-family:var(--rf-font-mono);font-size:10px;letter-spacing:.1em;color:#ff8a5a;border:1px solid #3a241c;border-radius:6px;padding:5px 7px;">PDF</span>
  <div style="flex:1;min-width:160px;">
    <div style="font-family:var(--rf-font-mono);font-size:9px;letter-spacing:.18em;color:#7a7a72;margin-bottom:6px;">CURRICULUM VITAE · PDF</div>
    <div style="font-family:var(--rf-font-mono);font-size:12px;letter-spacing:.04em;color:#cfcfca;overflow-wrap:anywhere;">Michal_Tajchert_CV.pdf</div>
  </div>
  <a href="/michal-tajchert-cv.pdf" download="Michal_Tajchert_CV.pdf" aria-label="Download CV as PDF" class="pf-card-soft" style="font-family:var(--rf-font-mono);font-size:10px;letter-spacing:.14em;color:#cfcfca;border:1px solid #2a2a2a;background:#0a0a0a;border-radius:999px;padding:9px 18px;font-weight:700;white-space:nowrap;">↓ DOWNLOAD PDF</a>
</div>
<script>
  import '../../web-components/cv-actions.js';
</script>
