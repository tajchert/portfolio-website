---
// One CV card with PDF as the primary download and Markdown COPY / SAVE actions.
// Markdown is canonical; the supplied PDF is a formatted snapshot of the CV.
import cvRaw from '../../../michal-tajchert-cv.md?raw';
import Glyph from '../Glyph.astro';
const cvB64 = Buffer.from(cvRaw, 'utf-8').toString('base64');
---
<portfolio-cv-actions
  data-filename="michal-tajchert-cv.md"
  data-md={cvB64}
>
  <div class="pf-cv-card">
    <div class="pf-cv-identity">
      <span style="display:flex;align-items:center;gap:3px;flex-shrink:0;">
        <Glyph shape="dot" w={6} h={6} />
        <Glyph shape="bar" w={22} h={6} />
        <Glyph shape="dot" w={6} h={6} accent />
      </span>
      <div style="min-width:0;">
        <div style="font-family:var(--rf-font-mono);font-size:9px;letter-spacing:.18em;color:#7a7a72;margin-bottom:6px;">CURRICULUM VITAE · 履歴書</div>
        <div style="font-family:var(--rf-font-mono);font-size:12px;letter-spacing:.04em;color:#cfcfca;overflow-wrap:anywhere;">michal-tajchert-cv</div>
      </div>
    </div>
    <div class="pf-cv-options">
      <a href="/michal-tajchert-cv.pdf" download="Michal_Tajchert_CV.pdf" aria-label="Download CV as PDF" class="pf-cv-action pf-cv-action--primary">↓ DOWNLOAD PDF</a>
      <div class="pf-cv-secondary">
        <button data-act="copy" aria-label="Copy CV markdown to clipboard" class="pf-cv-action" disabled>COPY</button>
        <button data-act="save" aria-label="Download CV markdown file" class="pf-cv-action" disabled>↓ MD</button>
      </div>
    </div>
  </div>
</portfolio-cv-actions>
<script>
  import './CvActions.client.js';
</script>
